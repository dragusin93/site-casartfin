---
/**
 * Pagina directiei premium: finisaje de interior pentru apartamente, case si
 * spatii HoReCa.
 *
 * Tonul e diferit fata de pagina industriala. Acolo conteaza suprafata,
 * termenul si graficul; aici conteaza detaliul, materialul si cum arata la
 * final. Nu reciclati textele dintr-o parte in cealalta.
 *
 * NOTA: zona asta e cea mai slaba fotografic din tot site-ul — doua fotografii
 * bune (HoReCa, tencuiala decorativa) si cateva de grupuri sanitare. Premium-ul
 * se vinde pe imagine; cand clientul trimite poze noi, aici e primul loc unde
 * trebuie puse.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import IconServiciu from '~/components/IconServiciu.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import { SERVICII_PREMIUM, ANGAJAMENTE_PREMIUM } from '~/data/directii';
import { LUCRARI } from '~/data/lucrari';
import pozaCap from '~/assets/lucrari/tencuiala-decorativa-iluminat-led.jpg';

const proiecte = LUCRARI.filter(
  (l) => l.categorie === 'comercial' || l.categorie === 'rezidential',
);

const firimituri = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasă', item: new URL('/', Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Finisaje premium',
      item: new URL('/finisaje-premium', Astro.site).href,
    },
  ],
};
---

<BaseLayout
  titlu="Finisaje premium interioare Râmnicu Vâlcea | CASARTFIN"
  descriere="Tencuieli decorative, microciment, tavane cu iluminat și amenajări complete pentru apartamente, case și spații HoReCa în Râmnicu Vâlcea."
  cale="/finisaje-premium"
>
  <section class="cap">
    <div class="container cap__grila">
      <div class="cap__text">
        <p class="eticheta">Direcția 02 · Premium</p>
        <h1>Finisaje premium<br />pentru interioare</h1>
        <div class="cota cap__cota" aria-hidden="true"><span class="cota__linie"></span></div>
        <p class="cap__sub">
          Apartamente, case și spații HoReCa. Lucrăm la detaliu — acolo unde lumina razantă
          arată fiecare imperfecțiune, iar rostul aliniat se vede mai mult decât materialul.
        </p>
        <div class="cap__actiuni">
          <a href="/#calculator" class="btn btn--primar">Cere ofertă</a>
          <a href="#proiecte-premium" class="btn btn--contur">Vezi lucrări</a>
        </div>
      </div>

      <figure class="cap__foto">
        <Picture
          src={pozaCap}
          alt="Perete cu tencuială decorativă texturată și inel luminos LED integrat, lângă placare din lemn"
          formats={['avif', 'webp']}
          widths={[480, 760, 1100]}
          sizes="(max-width: 980px) 92vw, 480px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="sectiune servicii-prem">
    <div class="container">
      <div class="antet">
        <p class="eticheta">Ce executăm</p>
        <h2>Finisaje la care contează<br />ultimul milimetru</h2>
      </div>

      <ul class="lista-servicii">
        {
          SERVICII_PREMIUM.map((s, i) => (
            <li>
              <span class="numar mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon">
                <IconServiciu nume={s.icon} size={22} />
              </span>
              <h3>{s.titlu}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sectiune arhitecti">
    <div class="container arhitecti__grila">
      <div>
        <p class="eticheta">Pentru arhitecți și designeri</p>
        <h2>Executăm ce ați desenat,<br />nu ce e mai ușor de făcut</h2>
        <p class="arhitecti__sub">
          Cea mai mare parte din frustrarea unui proiectant vine din execuția care simplifică
          detaliul. Noi lucrăm invers.
        </p>
      </div>

      <ul class="angajamente">
        {
          ANGAJAMENTE_PREMIUM.map((a) => (
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span>{a}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sectiune proiecte-prem" id="proiecte-premium">
    <div class="container">
      <div class="antet antet--rand">
        <div>
          <p class="eticheta">Lucrări</p>
          <h2>Interioare executate</h2>
        </div>
        <a href="/lucrari" class="legatura">
          Portofoliul complet
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <ul class="grila-poze">
        {
          proiecte.map((l, i) => (
            <li class={i === 0 ? 'mare' : ''}>
              <Picture
                src={l.src}
                alt={l.alt}
                formats={['avif', 'webp']}
                widths={[380, 680, 1000]}
                sizes={i === 0 ? '(max-width: 760px) 92vw, 54vw' : '(max-width: 760px) 92vw, 27vw'}
                loading="lazy"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaFinal />

  <script type="application/ld+json" set:html={JSON.stringify(firimituri)} is:inline />
</BaseLayout>

<style>
  /* ---- Cap de pagina ---- */
  .cap {
    padding: calc(76px + clamp(2.5rem, 6vw, 4.5rem)) var(--sp-gut) clamp(2.5rem, 5vw, 4rem);
    background: var(--stone);
  }

  .cap__grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cap h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    margin: 1rem 0 1.25rem;
  }

  .cap__cota {
    max-width: 200px;
  }

  .cap__sub {
    margin-top: 1.4rem;
    max-width: 46ch;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.78;
    color: var(--ink-2);
  }

  .cap__actiuni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .cap__foto {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--stone-2);
    padding: 10px;
    justify-self: end;
    width: 100%;
    max-width: 500px;
  }

  .cap__foto :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* ---- Antete ---- */
  .antet {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .antet h2 {
    margin-top: 1rem;
  }

  .antet--rand {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .legatura {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line-indigo);
    font-size: 0.88rem;
    color: var(--indigo);
    white-space: nowrap;
  }

  .legatura:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* ---- Servicii ---- */
  .servicii-prem {
    background: var(--stone-2);
    border-block: 1px solid var(--line);
  }

  .lista-servicii {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .lista-servicii li {
    position: relative;
    background: var(--stone-2);
    padding: 1.9rem 1.7rem;
  }

  .numar {
    position: absolute;
    top: 1.5rem;
    right: 1.6rem;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--terra-text);
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 1.1rem;
    border: 1px solid var(--line-indigo);
    color: var(--indigo);
  }

  .lista-servicii h3 {
    font-size: 1.08rem;
    margin-bottom: 0.55rem;
  }

  .lista-servicii p {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.72;
    color: var(--ink-2);
  }

  /* ---- Arhitecți ---- */
  .arhitecti {
    background: var(--stone);
  }

  .arhitecti__grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .arhitecti h2 {
    margin: 1rem 0 1.1rem;
  }

  .arhitecti__sub {
    font-size: 0.94rem;
    font-weight: 300;
    line-height: 1.78;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .angajamente {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .angajamente li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    font-size: 0.89rem;
    font-weight: 300;
    line-height: 1.68;
    color: var(--ink-2);
  }

  .angajamente svg {
    color: var(--indigo);
    flex-shrink: 0;
    margin-top: 4px;
  }

  /* ---- Proiecte ---- */
  .proiecte-prem {
    background: var(--stone-2);
    border-block: 1px solid var(--line);
  }

  .grila-poze {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .grila-poze li {
    overflow: hidden;
    background: var(--stone-3);
  }

  /* prima lucrare, ca ancora vizuala */
  .grila-poze .mare {
    grid-column: span 2;
    grid-row: span 2;
  }

  .grila-poze :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grila-poze .mare :global(img) {
    aspect-ratio: 8 / 7;
  }

  .grila-poze li:hover :global(img) {
    transform: scale(1.03);
  }

  /* ---- Adaptare ---- */
  @media (max-width: 980px) {
    .cap__grila,
    .arhitecti__grila {
      grid-template-columns: 1fr;
    }

    .cap__foto {
      justself: center;
      max-width: 420px;
    }

    .lista-servicii {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .grila-poze {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grila-poze .mare {
      grid-column: span 2;
      grid-row: auto;
    }

    .grila-poze .mare :global(img) {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 620px) {
    .lista-servicii {
      grid-template-columns: 1fr;
    }

    .cap__actiuni .btn {
      width: 100%;
    }
  }
</style>
