---
/**
 * Prima pagina — hub.
 *
 * Tine pozitionarea industriala in hero, apoi bifurca imediat catre cele doua
 * directii. Continutul tehnic (nomenclator de servicii, etape, tipuri de
 * clienti, fonduri europene) sta pe /hale-industriale, iar partea de finisaje
 * fine pe /finisaje-premium — ca pagina asta sa ramana scurta si sa se citeasca
 * din derulare, nu din lectura.
 *
 * Nu readauga aici sectiuni mutate pe paginile de directie.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import DouaDirectii from '~/components/DouaDirectii.astro';
import ProiecteIndustriale from '~/components/ProiecteIndustriale.astro';
import DeCe from '~/components/DeCe.astro';
import Despre from '~/components/Despre.astro';
import Calculator from '~/components/Calculator.astro';
import Intrebari from '~/components/Intrebari.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Contact from '~/components/Contact.astro';
---

<BaseLayout
  titlu="Compartimentări și finisaje hale Râmnicu Vâlcea | CASARTFIN"
  descriere="Compartimentări gips-carton, izolații și finisaje pentru hale, depozite și spații comerciale în Râmnicu Vâlcea. Lucrări la înălțime, ofertă în 24h."
  cale="/"
>
  <Hero />
  <DouaDirectii />
  <ProiecteIndustriale />
  <DeCe />
  <Despre />
  <Calculator />
  <Intrebari />
  <CtaFinal />
  <Contact />
</BaseLayout>
