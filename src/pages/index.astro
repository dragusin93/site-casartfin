---
/**
 * Prima pagina. Structura urmeaza pozitionarea pe hale si spatii industriale:
 * hero -> ce executam -> dovada (proiecte) -> de ce noi -> pentru cine ->
 * oferta. Rezidentialul sta jos, ca sectiune secundara.
 *
 * Text putin, imagine multa. Nu readauga sectiuni doar ca sa umpli pagina.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import Servicii from '~/components/Servicii.astro';
import ProiecteIndustriale from '~/components/ProiecteIndustriale.astro';
import DeCe from '~/components/DeCe.astro';
import LucramPentru from '~/components/LucramPentru.astro';
import Fonduri from '~/components/Fonduri.astro';
import Despre from '~/components/Despre.astro';
import Calculator from '~/components/Calculator.astro';
import Rezidential from '~/components/Rezidential.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Contact from '~/components/Contact.astro';
---

<BaseLayout
  titlu="Compartimentări și finisaje hale — Râmnicu Vâlcea | CASARTFIN"
  descriere="Compartimentări gips-carton, pereți, tavane, izolații și finisaje complete pentru hale industriale, depozite și spații comerciale în Râmnicu Vâlcea și județul Vâlcea. Lucrări la înălțime, ofertă în 24 de ore."
  cale="/"
>
  <Hero />
  <Servicii />
  <ProiecteIndustriale />
  <DeCe />
  <LucramPentru />
  <Fonduri />
  <Despre />
  <Calculator />
  <Rezidential />
  <CtaFinal />
  <Contact />
</BaseLayout>
