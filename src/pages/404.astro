---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { FIRMA } from '~/data/firma';
---

<BaseLayout
  titlu="Pagina nu a fost găsită — CASARTFIN CONSTRUCT"
  descriere="Pagina căutată nu există. Întoarce-te la prima pagină sau contactează-ne direct."
  cale="/404"
  noindex
>
  <section class="eroare">
    <div class="eroare__continut">
      <p class="eticheta">Eroare 404</p>
      <h1>Pagina asta nu există.</h1>
      <p class="subtitlu">
        Probabil linkul e greșit sau pagina a fost mutată. Dacă ai ajuns aici căutând ceva
        anume, sună-ne — îți spunem direct.
      </p>
      <div class="eroare__actiuni">
        <a href="/" class="btn btn--primar">Înapoi la prima pagină</a>
        <a href={`tel:${FIRMA.telefon}`} class="btn btn--contur">{FIRMA.telefonAfisat}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eroare {
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: calc(76px + 4rem) var(--sp-gut) 5rem;
  }

  .eroare__continut {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
  }

  .eroare__continut h1 {
    margin: 1rem 0 1.25rem;
  }

  .eroare__continut .subtitlu {
    margin-inline: auto;
  }

  .eroare__actiuni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2.25rem;
  }

  .eroare :global(.eticheta) {
    justify-content: center;
  }
</style>
