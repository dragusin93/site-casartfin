---
/**
 * Layoutul de baza: <head>, SEO, date structurate, header si footer.
 * Orice pagina noua il foloseste — asa tag-urile SEO raman consecvente.
 */
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { FIRMA } from '~/data/firma';

interface Props {
  titlu: string;
  descriere: string;
  /** Cale relativa, ex. "/termeni". Implicit pagina curenta. */
  cale?: string;
  /** Ascunde pagina din Google (folosit pe pagini de confirmare). */
  noindex?: boolean;
}

const { titlu, descriere, cale, noindex = false } = Astro.props;

const canonical = new URL(cale ?? Astro.url.pathname, Astro.site);
const ogImagine = new URL('/og-casartfin.jpg', Astro.site);

/**
 * Date structurate pentru Google.
 * LocalBusiness este cel mai important tag SEO pentru o firma locala:
 * de el depind afisarea in Google Maps si in rezultatele "langa mine".
 */
const dateStructurate = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${Astro.site}#firma`,
  name: FIRMA.nume,
  alternateName: FIRMA.numeScurt,
  description: FIRMA.descriere,
  url: Astro.site?.toString(),
  telephone: FIRMA.telefon,
  email: FIRMA.email,
  foundingDate: FIRMA.dataInfiintare,
  vatID: `RO${FIRMA.cui}`,
  taxID: FIRMA.cui,
  image: ogImagine.toString(),
  logo: new URL('/logo-casartfin.png', Astro.site).toString(),
  // Adresa afisata e biroul, acolo unde vin clientii si unde arata harta.
  address: {
    '@type': 'PostalAddress',
    streetAddress: FIRMA.birou.strada,
    addressLocality: FIRMA.birou.oras,
    addressRegion: FIRMA.birou.judet,
    postalCode: FIRMA.birou.codPostal,
    addressCountry: FIRMA.birou.tara,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: FIRMA.geo.lat,
    longitude: FIRMA.geo.lng,
  },
  areaServed: FIRMA.zone.map((z) => ({ '@type': 'Place', name: z })),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
  knowsAbout: [
    'Pereți gips carton',
    'Tavane false',
    'Tencuială mecanizată',
    'Lavabilă mecanizată',
    'Tencuieli decorative',
    'Compartimentări interioare',
    'Finisaje interioare',
  ],
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{titlu}</title>
    <meta name="description" content={descriere} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo-casartfin.png" />
    <meta name="theme-color" content="#26355C" />

    <!-- Open Graph: cum arata link-ul cand e trimis pe WhatsApp sau Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={FIRMA.nume} />
    <meta property="og:title" content={titlu} />
    <meta property="og:description" content={descriere} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagine} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titlu} />
    <meta name="twitter:description" content={descriere} />
    <meta name="twitter:image" content={ogImagine} />

    <!-- Fonturi -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@300;400;500;600&family=Archivo:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(dateStructurate)} is:inline />

    {/* Marcheaza ca JS ruleaza, ca abia atunci sa se ascunda elementele `.apare`.
        Inline si in <head>, ca sa nu apara o licarire inainte de prima pictura. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#continut" class="sari-la-continut">Sari la conținut</a>
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />

    <script>
      // Apariția elementelor la derulare.
      // IntersectionObserver în loc de listener pe scroll: browserul decide
      // singur când să evalueze, fără să recalculeze layoutul la fiecare pixel.
      const tinte = document.querySelectorAll<HTMLElement>('.apare');

      if (tinte.length) {
        // threshold 0: e destul ca un singur pixel al elementului sa intre in
        // ecran. Cu un prag mai mare, la derulare rapida elementele pot trece
        // complet prin viewport fara ca observatorul sa apuce sa le raporteze,
        // si ar ramane invizibile definitiv.
        const observator = new IntersectionObserver(
          (intrari) => {
            for (const intrare of intrari) {
              if (!intrare.isIntersecting) continue;
              intrare.target.classList.add('vizibil');
              observator.unobserve(intrare.target);
            }
          },
          { threshold: 0, rootMargin: '120px 0px 120px 0px' },
        );

        tinte.forEach((t) => observator.observe(t));

        // Plasa de siguranta. La derulare foarte rapida, un element poate
        // traversa tot ecranul intre doua raportari ale observatorului si ar
        // ramane invizibil definitiv. Maturam periodic ce a ramas in urma.
        let ramase = tinte.length;
        let programat = false;

        function matura() {
          programat = false;

          for (const t of tinte) {
            if (t.classList.contains('vizibil')) continue;

            // Orice a intrat in ecran sau a trecut deja de el devine vizibil.
            if (t.getBoundingClientRect().top < window.innerHeight) {
              t.classList.add('vizibil');
              observator.unobserve(t);
              ramase--;
            }
          }

          // Cand nu mai e nimic de aratat, scoatem ascultatorul cu totul.
          if (ramase <= 0) {
            window.removeEventListener('scroll', laDerulare);
            observator.disconnect();
          }
        }

        function laDerulare() {
          if (programat) return;
          programat = true;
          requestAnimationFrame(matura);
        }

        window.addEventListener('scroll', laDerulare, { passive: true });
        window.addEventListener('load', matura);
      }
    </script>

    <style>
      /* Link pentru navigare la tastatură: invizibil până la Tab. */
      .sari-la-continut {
        position: absolute;
        top: -100px;
        left: var(--sp-gut);
        z-index: 2000;
        padding: 0.75rem 1.25rem;
        background: var(--indigo);
        color: var(--stone-2);
        font-size: 0.85rem;
        transition: top 0.2s ease;
      }

      .sari-la-continut:focus {
        top: 0.75rem;
        color: var(--stone-2);
      }
    </style>
  </body>
</html>
