---
/** Layout pentru paginile de text lung (politici, termeni). */
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Props {
  titlu: string;
  descriere: string;
  cale: string;
  antet: string;
  actualizat: string;
}

const { titlu, descriere, cale, antet, actualizat } = Astro.props;
---

<BaseLayout titlu={titlu} descriere={descriere} cale={cale}>
  <article class="pagina-text">
    <div class="pagina-text__container">
      <header class="pagina-text__antet">
        <p class="eticheta">Document</p>
        <h1>{antet}</h1>
        <p class="pagina-text__data mono">Ultima actualizare: {actualizat}</p>
      </header>

      <div class="pagina-text__continut">
        <slot />
      </div>

      <p class="pagina-text__inapoi">
        <a href="/">← Înapoi la prima pagină</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .pagina-text {
    padding: calc(76px + clamp(3rem, 7vw, 5.5rem)) var(--sp-gut) clamp(4rem, 8vw, 6rem);
    background: var(--stone);
  }

  .pagina-text__container {
    max-width: 760px;
    margin-inline: auto;
  }

  .pagina-text__antet {
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .pagina-text__antet h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: 1rem 0 0.9rem;
  }

  .pagina-text__data {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .pagina-text__continut :global(h2) {
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    margin: 2.75rem 0 0.9rem;
  }

  .pagina-text__continut :global(h2:first-child) {
    margin-top: 0;
  }

  .pagina-text__continut :global(h3) {
    font-size: 1.05rem;
    margin: 1.75rem 0 0.6rem;
  }

  .pagina-text__continut :global(p) {
    font-size: 0.94rem;
    font-weight: 300;
    line-height: 1.85;
    color: var(--ink-2);
    margin-bottom: 1.1rem;
  }

  .pagina-text__continut :global(ul),
  .pagina-text__continut :global(ol) {
    margin: 0 0 1.4rem 1.25rem;
  }

  .pagina-text__continut :global(li) {
    font-size: 0.94rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--ink-2);
    margin-bottom: 0.5rem;
    padding-left: 0.4rem;
  }

  .pagina-text__continut :global(li::marker) {
    color: var(--terra);
  }

  .pagina-text__continut :global(a) {
    color: var(--indigo);
    border-bottom: 1px solid var(--line-indigo);
  }

  .pagina-text__continut :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .pagina-text__continut :global(.nota-revizuire) {
    padding: 1rem 1.2rem;
    margin-bottom: 2rem;
    background: rgba(180, 105, 74, 0.08);
    border-left: 2px solid var(--terra);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .pagina-text__inapoi {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  .pagina-text__inapoi a {
    color: var(--indigo);
  }
</style>
