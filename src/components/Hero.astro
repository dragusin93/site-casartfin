---
/**
 * Hero — pozitionare pe hale si spatii industriale.
 *
 * Text putin, o lucrare reala mare in dreapta, inelele cu unelte in spate ca
 * textura discreta. Titlul poarta cuvintele dupa care se cauta efectiv:
 * "compartimentari", "hale", "spatii industriale".
 */
import IneleUnelte from '~/components/IneleUnelte.astro';
import CaruselHero from '~/components/CaruselHero.astro';
import { FIRMA } from '~/data/firma';

const DATE = [
  { valoare: '20+', eticheta: 'Ani de meserie' },
  { valoare: '10 m', eticheta: 'Înălțime de lucru' },
  { valoare: '24h', eticheta: 'Timp de răspuns' },
  { valoare: '2 ani', eticheta: 'Garanție scrisă' },
];
---

<section class="hero" id="hero">
  <div class="hero__grila container">
    <div class="hero__text">
      <p class="eticheta">Râmnicu Vâlcea · Județul Vâlcea</p>

      <h1>
        Compartimentări și finisaje pentru
        <em>hale și spații industriale</em>
      </h1>

      <div class="cota hero__cota" aria-hidden="true"><span class="cota__linie"></span></div>

      <p class="hero__subtitlu">
        De la structură și compartimentare până la finisajul final.
      </p>

      <div class="hero__actiuni">
        <a href="#calculator" class="btn btn--primar">
          Cere ofertă
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/lucrari" class="btn btn--contur">Vezi proiectele</a>
      </div>

      <p class="hero__telefon">
        <a href={`tel:${FIRMA.telefon}`} class="mono">{FIRMA.telefonAfisat}</a>
        <span>· {FIRMA.program}</span>
      </p>
    </div>

    <div class="hero__vizual">
      <div class="hero__inele" aria-hidden="true"><IneleUnelte /></div>

      <CaruselHero />
    </div>
  </div>

  <div class="banda-date">
    <div class="banda-date__interior container">
      {
        DATE.map((d) => (
          <div class="banda-date__celula">
            <span class="banda-date__valoare">{d.valoare}</span>
            <span class="banda-date__eticheta mono">{d.eticheta}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 76px;
    position: relative;
    overflow: hidden;
  }

  .hero__grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(2.75rem, 6vw, 5rem) var(--sp-gut);
  }

  /* ---- Text ---- */
  .hero__text h1 {
    margin: 1.25rem 0 1.5rem;
    font-size: clamp(2.1rem, 4.4vw, 3.5rem);
    line-height: 1.08;
  }

  .hero__text em {
    font-style: normal;
    color: var(--indigo);
    font-weight: 600;
    display: block;
  }

  .hero__cota {
    max-width: 220px;
  }

  .hero__subtitlu {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .hero__actiuni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.25rem;
  }

  .hero__telefon {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    color: var(--ink-3);
  }

  .hero__telefon a {
    color: var(--indigo);
    border-bottom: 1px solid var(--line-indigo);
    margin-right: 0.35rem;
  }

  /* ---- Vizual ---- */
  .hero__vizual {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 540px;
  }

  /* Inelele raman, dar retrase: textura tehnica in spatele fotografiei. */
  .hero__inele {
    position: absolute;
    left: -30%;
    top: 50%;
    transform: translateY(-50%);
    width: 118%;
    opacity: 0.5;
    pointer-events: none;
  }

  /* ---- Banda de date ---- */
  .banda-date {
    border-block: 1px solid var(--line);
    background: var(--stone-2);
  }

  .banda-date__interior {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-inline: var(--sp-gut);
  }

  .banda-date__celula {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.5rem clamp(0.75rem, 2vw, 2rem);
    border-left: 1px solid var(--line);
  }

  .banda-date__celula:first-child {
    border-left: none;
    padding-left: 0;
  }

  .banda-date__valoare {
    font-family: var(--f-display);
    font-size: clamp(1.55rem, 2.6vw, 2.1rem);
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
  }

  .banda-date__eticheta {
    font-size: 0.56rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ---- Adaptare ---- */
  @media (max-width: 980px) {
    .hero__grila {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero__vizual {
      justify-self: center;
      max-width: 460px;
    }

    .hero__inele {
      left: -22%;
      width: 100%;
      opacity: 0.35;
    }
  }

  @media (max-width: 720px) {
    .banda-date__interior {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .banda-date__celula:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }

    .banda-date__celula:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .hero__actiuni .btn {
      width: 100%;
    }
  }
</style>
