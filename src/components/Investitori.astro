---
const ARGUMENTE = [
  {
    titlu: 'Creștere organică dovedită',
    text: 'Peste 100 de proiecte finalizate, construite exclusiv prin calitate și recomandări directe, fără publicitate masivă.',
  },
  {
    titlu: 'Contracte recurente',
    text: 'Colaborări active cu promotori imobiliari, firme de construcții și beneficiari de fonduri europene, care generează venituri previzibile.',
  },
  {
    titlu: 'Expansiune regională',
    text: 'Plan concret de extindere în Oltenia și Muntenia, cu echipe proprii și procese replicabile.',
  },
  {
    titlu: 'Transparență financiară',
    text: 'Situații financiare clare, devize detaliate și comunicare directă — partenerul știe exact unde merg banii.',
  },
];

const INTERESE = [
  'Investiție financiară / participare la capital',
  'Parteneriat comercial — furnizor materiale',
  'Parteneriat execuție — subantrepriză',
  'Parteneriat arhitectură / design interior',
  'Alt tip de colaborare',
];
---

<section class="sectiune investitori" id="investitori">
  <div class="container investitori__grila">
    <div class="investitori__text">
      <p class="eticheta apare">Investitori și parteneri strategici</p>
      <h2 class="apare i1">Investește în construcții<br />cu cerere reală.</h2>
      <p class="subtitlu apare i2">
        CASARTFIN e o firmă de familie cu rădăcini solide și un plan concret de creștere:
        portofoliu dovedit, echipă stabilă și o piață în expansiune.
      </p>

      <ul class="investitori__lista apare i3">
        {
          ARGUMENTE.map((a) => (
            <li>
              <h3>{a.titlu}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="investitori__formular apare i2">
      <h3 class="investitori__form-titlu">Devino partener strategic</h3>
      <p class="investitori__form-sub">
        Discuție confidențială în maximum 24 de ore. Prezentăm cifrele reale, nu promisiuni.
      </p>

      {/* vezi nota despre method="post" din Calculator.astro */}
      <form id="form-investitori" method="post" novalidate>
        <div class="camp">
          <label for="inv-interes">Ce te interesează? *</label>
          <select id="inv-interes" name="interes" required>
            <option value="">Selectează...</option>
            {INTERESE.map((i) => <option value={i}>{i}</option>)}
          </select>
        </div>

        <div class="camp-randuri">
          <div class="camp">
            <label for="inv-nume">Nume *</label>
            <input type="text" id="inv-nume" name="nume" placeholder="Numele dvs." required />
          </div>
          <div class="camp">
            <label for="inv-telefon">Telefon *</label>
            <input type="tel" id="inv-telefon" name="telefon" placeholder="07xx xxx xxx" required />
          </div>
        </div>

        <div class="camp">
          <label for="inv-firma">Firmă</label>
          <input type="text" id="inv-firma" name="firma" placeholder="Denumirea firmei" />
        </div>

        <div class="camp">
          <label for="inv-mesaj">Mesaj</label>
          <textarea id="inv-mesaj" name="mesaj" placeholder="Pe scurt, ce propuneți..."></textarea>
        </div>

        <div class="capcana" aria-hidden="true">
          <label for="inv-website">Nu completa acest câmp</label>
          <input type="text" id="inv-website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="camp-acord">
          <input type="checkbox" id="inv-acord" name="acord" value="da" required />
          <label for="inv-acord">
            Sunt de acord cu prelucrarea datelor conform
            <a href="/politica-confidentialitate">politicii de confidențialitate</a>.
          </label>
        </div>

        <button type="submit" class="btn btn--primar btn--plin" data-trimite>
          Trimite propunerea
        </button>

        <p class="form-raspuns" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { initFormular } from '~/scripts/formular';

  initFormular({
    formId: 'form-investitori',
    sursa: 'Investitori',
    titluWhatsApp: 'Vă contactez în legătură cu o propunere de parteneriat.',
  });
</script>

<style>
  .investitori {
    background: var(--stone);
  }

  .investitori__grila {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .investitori__text h2 {
    margin: 1rem 0 1.5rem;
  }

  .investitori__lista {
    list-style: none;
    margin-top: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .investitori__lista li {
    padding: 1.3rem 0;
    border-top: 1px solid var(--line);
  }

  .investitori__lista li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .investitori__lista h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .investitori__lista p {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.72;
    color: var(--ink-2);
  }

  .investitori__formular {
    background: var(--stone-2);
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    position: sticky;
    top: 96px;
  }

  .investitori__form-titlu {
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
  }

  .investitori__form-sub {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--ink-2);
    margin-bottom: 1.75rem;
  }

  .capcana {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .investitori__grila {
      grid-template-columns: 1fr;
    }

    .investitori__formular {
      position: static;
    }
  }
</style>
