---
const COLABORARI = [
  {
    titlu: 'Dezvoltatori imobiliari',
    text: 'Execuție pe ansambluri rezidențiale, cu echipe dimensionate pe grafic și facturare pe tronsoane.',
  },
  {
    titlu: 'Firme de construcții',
    text: 'Subantrepriză pe partea de gips carton, tencuieli și finisaje, cu personal propriu și utilaje proprii.',
  },
  {
    titlu: 'Furnizori de materiale',
    text: 'Colaborări pe volum cu distribuitori de sisteme Knauf, Rigips și materiale de finisaj.',
  },
  {
    titlu: 'Beneficiari instituționali',
    text: 'Lucrări în spații publice și clădiri de birouri, cu documentația cerută de auditori.',
  },
];
---

<section class="sectiune parteneri" id="parteneri">
  <div class="container">
    <div class="cap-sectiune">
      <p class="eticheta apare">Colaborări</p>
      <h2 class="apare i1">Cu cine lucrăm</h2>
      <p class="subtitlu apare i2">
        Nu lucrăm doar cu beneficiari finali. O bună parte din volumul nostru vine din
        colaborări constante cu firme care au nevoie de o echipă pe care se pot baza.
      </p>
    </div>

    <ul class="parteneri__lista">
      {
        COLABORARI.map((c, i) => (
          <li class={`partener apare i${(i % 4) + 1}`}>
            <div class="cota partener__cota" aria-hidden="true">
              <span class="cota__linie" />
            </div>
            <h3>{c.titlu}</h3>
            <p>{c.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .parteneri {
    background: var(--stone);
  }

  .parteneri__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem 2.5rem;
  }

  .partener__cota {
    margin-bottom: 1.1rem;
  }

  .partener h3 {
    font-size: 1.1rem;
    margin-bottom: 0.55rem;
  }

  .partener p {
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--ink-2);
  }
</style>
