---
/**
 * Inelele rotative cu uneltele de finisaje.
 *
 * Trei straturi concentrice care se rotesc in sensuri alternative:
 *   - exterior: arc partial cu scala de grade (ca la un raportor)
 *   - mijloc:   uneltele, in badge-uri patrate — driscă, spaclu, mistrie,
 *               rolă, nivelă cu bulă, ruletă
 *   - interior: cerc punctat fin
 * In centru sta toleranta de executie, care e argumentul tehnic al firmei.
 *
 * Elementul este pur decorativ: aria-hidden, deci cititoarele de ecran il sar.
 * La `prefers-reduced-motion` rotatia se opreste (regula globala din global.css).
 */

interface Props {
  class?: string;
}

const { class: clasa } = Astro.props;

/** Cele 6 unelte, asezate la 60° una de alta pe inelul din mijloc. */
const RAZA = 268;
const unelte = [
  { nume: 'Drișcă', unghi: -90 },
  { nume: 'Șpaclu', unghi: -30 },
  { nume: 'Mistrie', unghi: 30 },
  { nume: 'Rolă', unghi: 90 },
  { nume: 'Nivelă', unghi: 150 },
  { nume: 'Ruletă', unghi: 210 },
].map((u) => ({
  ...u,
  x: 400 + RAZA * Math.cos((u.unghi * Math.PI) / 180),
  y: 400 + RAZA * Math.sin((u.unghi * Math.PI) / 180),
}));

/** Gradatiile arcului exterior: din 5 in 5 grade, intre -120° si 120°. */
const gradatii = Array.from({ length: 49 }, (_, i) => {
  const unghi = -120 + i * 5;
  const mare = unghi % 30 === 0;
  const r1 = 352;
  const r2 = mare ? 374 : 364;
  const rad = (unghi * Math.PI) / 180;
  return {
    x1: 400 + r1 * Math.cos(rad),
    y1: 400 + r1 * Math.sin(rad),
    x2: 400 + r2 * Math.cos(rad),
    y2: 400 + r2 * Math.sin(rad),
    mare,
  };
});
---

<svg
  class:list={['inele', clasa]}
  viewBox="0 0 800 800"
  aria-hidden="true"
  focusable="false"
>
  <!-- Stratul exterior: arcul gradat -->
  <g class="inele__ext">
    <path
      d="M 224 573 A 204 204 0 1 1 576 573"
      transform="rotate(0 400 400)"
      fill="none"
      stroke="var(--indigo)"
      stroke-width="0.8"
      opacity="0.18"
      style="transform-origin:400px 400px;transform:scale(1.72)"
    ></path>
    {
      gradatii.map((g) => (
        <line
          x1={g.x1}
          y1={g.y1}
          x2={g.x2}
          y2={g.y2}
          stroke={g.mare ? 'var(--terra)' : 'var(--indigo)'}
          stroke-width={g.mare ? 1.6 : 0.8}
          opacity={g.mare ? 0.85 : 0.4}
        />
      ))
    }
  </g>

  <!-- Stratul din mijloc: uneltele -->
  <g class="inele__mij">
    <circle
      cx="400"
      cy="400"
      r={RAZA}
      fill="none"
      stroke="var(--ink)"
      stroke-width="0.7"
      opacity="0.12"
    ></circle>

    {
      unelte.map((u) => (
        <g transform={`translate(${u.x.toFixed(2)},${u.y.toFixed(2)})`}>
          <rect
            x="-27"
            y="-27"
            width="54"
            height="54"
            fill="var(--stone-2)"
            stroke="var(--indigo)"
            stroke-width="0.9"
            opacity="0.92"
          />
          <g
            transform="translate(-24,-24)"
            fill="none"
            stroke="var(--indigo)"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            {u.nume === 'Drișcă' && (
              <>
                <rect x="10" y="26" width="28" height="6" rx="1" />
                <path d="M19 26 V21 A5 5 0 0 1 29 21 V26" />
              </>
            )}
            {u.nume === 'Șpaclu' && (
              <>
                <path d="M8 20 L26 21.5 L26 28.5 L8 30 Z" />
                <rect x="26" y="22.5" width="6" height="5" />
                <rect x="32" y="21.5" width="8" height="7" rx="2" />
              </>
            )}
            {u.nume === 'Mistrie' && (
              <>
                <path d="M8 25 L27 18 L27 32 Z" />
                <path d="M27 25 H31" />
                <rect x="31" y="21" width="9" height="8" rx="2" />
              </>
            )}
            {u.nume === 'Rolă' && (
              <>
                <rect x="8" y="12" width="26" height="10" rx="2" />
                <path d="M21 22 V29 H32 V35" />
                <rect x="28" y="35" width="8" height="9" rx="2" />
              </>
            )}
            {u.nume === 'Nivelă' && (
              <>
                <rect x="5" y="20" width="38" height="9" rx="1" />
                <circle cx="24" cy="24.5" r="3.4" />
                <path d="M14 20 V29 M34 20 V29" />
              </>
            )}
            {u.nume === 'Ruletă' && (
              <>
                <rect x="10" y="14" width="23" height="21" rx="3" />
                <circle cx="21.5" cy="24" r="5.5" />
                <path d="M33 30 H39 V35" />
              </>
            )}
          </g>
        </g>
      ))
    }
  </g>

  <!-- Stratul interior -->
  <g class="inele__int">
    <circle
      cx="400"
      cy="400"
      r="186"
      fill="none"
      stroke="var(--indigo)"
      stroke-width="0.9"
      stroke-dasharray="2 9"
      opacity="0.4"></circle>
    <line x1="400" y1="168" x2="400" y2="196" stroke="var(--terra)" stroke-width="1.5"></line>
    <line x1="400" y1="604" x2="400" y2="632" stroke="var(--terra)" stroke-width="1.5"></line>
    <line x1="168" y1="400" x2="196" y2="400" stroke="var(--terra)" stroke-width="1.5"></line>
    <line x1="604" y1="400" x2="632" y2="400" stroke="var(--terra)" stroke-width="1.5"></line>
  </g>

  <!-- Centrul: specificatia tehnica -->
  <rect
    x="286"
    y="330"
    width="228"
    height="140"
    fill="var(--stone-2)"
    stroke="var(--ink)"
    stroke-width="0.8"
    opacity="0.96"></rect>
  <text
    x="400"
    y="378"
    text-anchor="middle"
    font-family="var(--f-mono)"
    font-size="11"
    letter-spacing="2.4"
    fill="var(--indigo)">TOLERANȚĂ EXECUȚIE</text>
  <text
    x="400"
    y="425"
    text-anchor="middle"
    font-family="var(--f-display)"
    font-size="44"
    font-weight="500"
    fill="var(--ink)">±2 mm</text>
  <text
    x="400"
    y="450"
    text-anchor="middle"
    font-family="var(--f-mono)"
    font-size="10"
    letter-spacing="1.8"
    fill="var(--ink-3)">LA 2 METRI LINIAR</text>
</svg>

<style>
  .inele {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .inele__ext,
  .inele__mij,
  .inele__int {
    transform-box: view-box;
    transform-origin: 400px 400px;
  }

  .inele__ext {
    animation: roteste-invers 200s linear infinite;
  }

  .inele__mij {
    animation: roteste 130s linear infinite;
  }

  .inele__int {
    animation: roteste-invers 95s linear infinite;
  }

  @keyframes roteste {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes roteste-invers {
    to {
      transform: rotate(-360deg);
    }
  }
</style>
