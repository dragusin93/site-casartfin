---
import { TOATE_SERVICIILE, TIPURI_MASURATOARE } from '~/data/servicii';
import { FIRMA } from '~/data/firma';
---

<section class="sectiune calculator" id="calculator">
  <div class="container">
    <div class="cap-sectiune">
      <p class="eticheta apare">Estimare rapidă</p>
      <h2 class="apare i1">Cere o ofertă<br />pentru lucrarea ta</h2>
      <p class="subtitlu apare i2">
        Completează ce știi despre proiect. Îți răspundem cu o estimare sau venim la
        măsurătoare — gratuit, fără obligații.
      </p>
    </div>

    <div class="calculator__grila">
      <div class="calculator__formular apare i1">
        <p class="calculator__nota">
          Prețurile variază în funcție de complexitatea lucrării. Oferta exactă se transmite
          după evaluarea proiectului.
        </p>

        {/* method="post" conteaza doar daca JS nu ruleaza: fara el, submit-ul
            nativ ar fi un GET si numele, telefonul si emailul ar ajunge in
            bara de adresa, in istoricul browserului si in log-urile Vercel. */}
        <form id="form-oferta" method="post" novalidate>
          <div class="camp">
            <label for="of-serviciu">Tip serviciu *</label>
            <select id="of-serviciu" name="serviciu" required>
              <option value="">Selectează serviciul...</option>
              {TOATE_SERVICIILE.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

          <fieldset class="masuratoare">
            <legend>Tip măsurătoare</legend>
            <div class="masuratoare__optiuni">
              {
                TIPURI_MASURATOARE.map((t, i) => (
                  <div class="masuratoare__optiune">
                    <input
                      type="radio"
                      name="masuratoare"
                      id={`m-${t.id}`}
                      value={t.eticheta}
                      checked={i === 0}
                      data-exemplu={t.exemplu ?? ''}
                      data-eticheta={t.eticheta}
                    />
                    <label for={`m-${t.id}`}>{t.scurt}</label>
                  </div>
                ))
              }
            </div>
          </fieldset>

          <div class="camp" id="camp-cantitate">
            <label for="of-cantitate" id="eticheta-cantitate">Suprafață (m²) *</label>
            <input
              type="number"
              id="of-cantitate"
              name="cantitate"
              placeholder="Ex: 45"
              min="0"
              step="0.1"
              required
            />
          </div>

          <div class="camp">
            <label for="of-detalii">Detalii despre proiect</label>
            <textarea
              id="of-detalii"
              name="detalii"
              placeholder="Tip spațiu (rezidențial / comercial / industrial), stadiul actual, termenul dorit..."
            ></textarea>
          </div>

          <div class="camp-randuri">
            <div class="camp">
              <label for="of-nume">Nume / Firmă *</label>
              <input type="text" id="of-nume" name="nume" placeholder="Numele dvs." required />
            </div>
            <div class="camp">
              <label for="of-telefon">Telefon *</label>
              <input
                type="tel"
                id="of-telefon"
                name="telefon"
                placeholder="07xx xxx xxx"
                required
              />
            </div>
          </div>

          <div class="camp">
            <label for="of-email">Email</label>
            <input type="email" id="of-email" name="email" placeholder="email@exemplu.com" />
          </div>

          {/* Capcana pentru roboti — ascunsa vizual si sarita la Tab. */}
          <div class="capcana" aria-hidden="true">
            <label for="of-website">Nu completa acest câmp</label>
            <input type="text" id="of-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="camp-acord">
            <input type="checkbox" id="of-acord" name="acord" value="da" required />
            <label for="of-acord">
              Sunt de acord ca datele mele să fie folosite pentru a primi un răspuns la această
              solicitare, conform <a href="/politica-confidentialitate">politicii de confidențialitate</a>.
            </label>
          </div>

          <div class="calculator__butoane">
            <button type="submit" class="btn btn--primar btn--plin" data-trimite>
              Trimite solicitarea
            </button>
            <a
              href={`https://wa.me/${FIRMA.telefon.replace(/\D/g, '')}`}
              class="btn btn--whatsapp btn--plin"
              target="_blank"
              rel="noopener"
              data-whatsapp
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
              </svg>
              Trimite pe WhatsApp
            </a>
          </div>

          <p class="form-raspuns" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="calculator__info apare i2">
        <div class="info-card">
          <h3>Răspuns în 24 de ore</h3>
          <p>
            Fiecare solicitare e analizată individual. Îți transmitem o ofertă detaliată sau
            venim la măsurătoare — gratuit și fără obligații.
          </p>
        </div>
        <div class="info-card">
          <h3>Deviz transparent</h3>
          <p>
            Primești costurile defalcate pe categorii de lucrări: manoperă, materiale,
            consumabile. Fără rubrica „diverse”.
          </p>
        </div>
        <div class="info-card">
          <h3>Preferi să vorbești direct?</h3>
          <p>
            Sună sau scrie pe WhatsApp la
            <a href={`tel:${FIRMA.telefon}`} class="mono">{FIRMA.telefonAfisat}</a>.
            Răspundem {FIRMA.program.toLowerCase()}.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import { initFormular } from '~/scripts/formular';

  initFormular({
    formId: 'form-oferta',
    sursa: 'Calculator ofertă',
    titluWhatsApp: 'Aș dori o ofertă pentru o lucrare de finisaje.',
  });

  // Câmpul de cantitate se adaptează la tipul de măsurătoare ales.
  const campCantitate = document.getElementById('camp-cantitate');
  const eticheta = document.getElementById('eticheta-cantitate');
  const input = document.getElementById('of-cantitate') as HTMLInputElement | null;

  document.querySelectorAll<HTMLInputElement>('input[name="masuratoare"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      if (!campCantitate || !eticheta || !input) return;

      const exemplu = radio.dataset.exemplu;

      // „Lucrare completă” nu are cantitate de introdus.
      if (!exemplu) {
        campCantitate.hidden = true;
        input.required = false;
        input.value = '';
        return;
      }

      campCantitate.hidden = false;
      input.required = true;
      eticheta.textContent = `${radio.dataset.eticheta} *`;
      input.placeholder = `Ex: ${exemplu}`;
    });
  });
</script>

<style>
  .calculator {
    background: var(--stone-2);
    border-block: 1px solid var(--line);
  }

  .calculator__grila {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  .calculator__formular {
    background: var(--stone);
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .calculator__nota {
    padding: 0.85rem 1rem;
    margin-bottom: 1.75rem;
    background: rgba(180, 105, 74, 0.07);
    border-left: 2px solid var(--terra);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* ---- Tip măsurătoare ---- */
  .masuratoare {
    border: none;
    margin-bottom: 1.15rem;
  }

  .masuratoare legend {
    font-family: var(--f-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.45rem;
    padding: 0;
  }

  .masuratoare__optiuni {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
    gap: 0.5rem;
  }

  .masuratoare__optiune input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .masuratoare__optiune label {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.5rem;
    background: var(--stone-2);
    border: 1px solid var(--line);
    border-radius: var(--r);
    font-family: var(--f-body);
    font-size: 0.84rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-2);
    cursor: pointer;
    transition: var(--tr);
  }

  .masuratoare__optiune input:checked + label {
    background: var(--indigo);
    border-color: var(--indigo);
    color: var(--stone-2);
  }

  .masuratoare__optiune input:focus-visible + label {
    outline: 2px solid var(--indigo);
    outline-offset: 3px;
  }

  #camp-cantitate[hidden] {
    display: none;
  }

  /* ---- Capcană pentru roboți ---- */
  .capcana {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .calculator__butoane {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }

  /* ---- Coloana de informații ---- */
  .calculator__info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .info-card {
    background: var(--stone);
    padding: 1.6rem 1.5rem;
  }

  .info-card h3 {
    font-size: 1.02rem;
    margin-bottom: 0.5rem;
  }

  .info-card p {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .info-card a {
    color: var(--indigo);
    border-bottom: 1px solid var(--line-indigo);
  }

  @media (max-width: 900px) {
    .calculator__grila {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .calculator__butoane {
      grid-template-columns: 1fr;
    }
  }
</style>
