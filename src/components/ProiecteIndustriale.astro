---
/**
 * Selectie scurta de proiecte industriale pentru prima pagina.
 *
 * NU e galeria completa: aceea sta pe /lucrari, cu categorii in cascada,
 * pentru ca asa a cerut clientul. Aici sunt doar cateva lucrari ca dovada,
 * plus usa catre portofoliul intreg.
 */
import { Picture } from 'astro:assets';
import { LUCRARI_INDUSTRIALE } from '~/data/lucrari';
---

<section class="proiecte" id="proiecte">
  <div class="container">
    <div class="proiecte__antet">
      <div>
        <p class="eticheta">Proiecte industriale</p>
        <h2>Lucrări executate în hale<br />și spații mari</h2>
      </div>
      <a href="/lucrari" class="proiecte__link">
        Vezi portofoliul complet
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <ul class="proiecte__grila">
      {
        LUCRARI_INDUSTRIALE.map((l, i) => (
          <li class={`proiect ${i === 0 ? 'proiect--mare' : ''}`}>
            <figure>
              <Picture
                src={l.src}
                alt={l.alt}
                formats={['avif', 'webp']}
                widths={[420, 720, 1100]}
                sizes={
                  i === 0
                    ? '(max-width: 760px) 92vw, 58vw'
                    : '(max-width: 760px) 92vw, 29vw'
                }
                loading={i < 2 ? 'eager' : 'lazy'}
                class="proiect__imagine"
              />
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proiecte {
    padding: var(--sp-sec) var(--sp-gut);
    background: var(--stone-2);
    border-block: 1px solid var(--line);
  }

  .proiecte__antet {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .proiecte__antet h2 {
    margin-top: 1rem;
  }

  .proiecte__link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line-indigo);
    font-size: 0.88rem;
    color: var(--indigo);
    white-space: nowrap;
  }

  .proiecte__link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .proiecte__link svg {
    transition: transform var(--tr);
  }

  .proiecte__link:hover svg {
    transform: translateX(4px);
  }

  /* Prima lucrare ocupa doua coloane si doua randuri — o ancora vizuala,
     nu patru dreptunghiuri identice. */
  .proiecte__grila {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .proiect {
    background: var(--stone-3);
    overflow: hidden;
  }

  .proiect--mare {
    grid-column: span 2;
    grid-row: span 2;
  }

  .proiect figure {
    margin: 0;
    height: 100%;
  }

  .proiect__imagine {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .proiect--mare .proiect__imagine {
    aspect-ratio: 8 / 7;
  }

  .proiect:hover .proiect__imagine {
    transform: scale(1.03);
  }

  @media (max-width: 760px) {
    .proiecte__grila {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proiect--mare {
      grid-column: span 2;
      grid-row: auto;
    }

    .proiect--mare .proiect__imagine {
      aspect-ratio: 16 / 10;
    }
  }
</style>
