---
/**
 * Finisaje rezidentiale — sectiune SECUNDARA, intentionat compacta.
 *
 * Firma se pozitioneaza pe hale si spatii industriale. Rezidentialul exista
 * si se executa, dar nu trebuie sa concureze vizual cu partea industriala:
 * de aceea e o banda scurta, nu o sectiune cu grila mare.
 */
import { Picture } from 'astro:assets';
import { LUCRARI } from '~/data/lucrari';

const pozeRezidentiale = LUCRARI.filter((l) => l.categorie === 'rezidential').slice(0, 3);
---

<section class="rezidential" id="rezidential">
  <div class="container rezidential__grila">
    <div class="rezidential__text">
      <p class="eticheta">Și pentru locuințe</p>
      <h2>Finisaje rezidențiale</h2>
      <p class="rezidential__descriere">
        Apartamente, case și lucrări mai mici. Aceeași echipă, aceleași materiale, aceeași
        grijă la detaliu — doar scara diferă.
      </p>
      <a href="/lucrari" class="rezidential__link">
        Vezi lucrări rezidențiale
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <ul class="rezidential__poze">
      {
        pozeRezidentiale.map((l) => (
          <li>
            <Picture
              src={l.src}
              alt={l.alt}
              formats={['avif', 'webp']}
              widths={[240, 420]}
              sizes="(max-width: 860px) 45vw, 200px"
              loading="lazy"
              class="rezidential__imagine"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rezidential {
    padding: clamp(3rem, 6vw, 4.5rem) var(--sp-gut);
    background: var(--stone);
  }

  .rezidential__grila {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  .rezidential__text h2 {
    margin: 0.9rem 0 0.9rem;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
  }

  .rezidential__descriere {
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .rezidential__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line-indigo);
    font-size: 0.86rem;
    color: var(--indigo);
  }

  .rezidential__link:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .rezidential__poze {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .rezidential__imagine {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .rezidential__grila {
      grid-template-columns: 1fr;
    }
  }
</style>
