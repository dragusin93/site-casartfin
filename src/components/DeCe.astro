---
import { MOTIVE } from '~/data/servicii';
import IconServiciu from '~/components/IconServiciu.astro';
---

<section class="dece" id="de-ce">
  <div class="container">
    <div class="dece__antet">
      <p class="eticheta">De ce CASARTFIN</p>
      <h2>Șase motive, fără vorbe multe</h2>
    </div>

    <ul class="dece__grila">
      {
        MOTIVE.map((m) => (
          <li class="motiv">
            <span class="motiv__icon">
              <IconServiciu nume={m.icon} size={22} />
            </span>
            <h3>{m.titlu}</h3>
            <p>{m.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .dece {
    padding: var(--sp-sec) var(--sp-gut);
    background: var(--stone);
  }

  .dece__antet {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .dece__antet h2 {
    margin-top: 1rem;
  }

  /* Exact 3 coloane, ca cele 6 motive sa iasa 3 sus si 3 jos.
     Cu `auto-fit` incapeau 4 pe ecran lat si ramanea o celula goala. */
  .dece__grila {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (max-width: 980px) {
    .dece__grila {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .dece__grila {
      grid-template-columns: 1fr;
    }
  }

  .motiv {
    background: var(--stone-2);
    padding: 1.9rem 1.7rem;
  }

  .motiv__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 1.1rem;
    border: 1px solid var(--line-indigo);
    color: var(--indigo);
  }

  .motiv h3 {
    font-size: 1.06rem;
    margin-bottom: 0.45rem;
  }

  .motiv p {
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-2);
  }
</style>
