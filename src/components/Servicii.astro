---
import { Picture } from 'astro:assets';
import { SERVICII_PRINCIPALE } from '~/data/servicii';
import IconServiciu from '~/components/IconServiciu.astro';
---

<section class="sectiune servicii" id="servicii">
  <div class="container">
    <div class="cap-sectiune">
      <p class="eticheta apare">Ce executăm</p>
      <h2 class="apare i1">Finisaje interioare și gips-carton,<br />executate corect.</h2>
      <p class="subtitlu apare i2">
        Lucrăm cu sisteme Knauf și Rigips originale, agrementate tehnic. Fiecare lucrare pleacă
        de la un proiect citit și de la un grafic de execuție asumat în scris.
      </p>
    </div>

    <ul class="servicii__lista">
      {
        SERVICII_PRINCIPALE.map((s, i) => (
          <li class={`serviciu apare i${(i % 3) + 1}`}>
            <figure class="serviciu__figura">
              <Picture
                src={s.poza}
                alt={s.pozaAlt}
                formats={['avif', 'webp']}
                widths={[320, 520, 760]}
                sizes="(max-width: 640px) 92vw, (max-width: 1080px) 46vw, 30vw"
                loading="lazy"
                class="serviciu__imagine"
              />
              <span class="serviciu__numar mono">{String(i + 1).padStart(2, '0')}</span>
            </figure>

            <div class="serviciu__corp">
              <span class="serviciu__icon">
                <IconServiciu nume={s.icon} />
              </span>
              <h3 class="serviciu__titlu">{s.titlu}</h3>
              <p class="serviciu__descriere">{s.descriere}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Singura usa catre portofoliu de pe prima pagina. Galeria nu mai sta
        aici, dar cineva care tocmai a citit ce executam vrea sa si vada. */}
    <a href="/lucrari" class="spre-lucrari apare i1">
      <span class="spre-lucrari__text">
        <span class="eticheta eticheta--simplu">Portofoliu</span>
        <span class="spre-lucrari__titlu">Vezi lucrările executate</span>
      </span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</section>

<style>
  .servicii {
    background: var(--stone);
  }

  .servicii__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    /* liniile dintre carduri se fac din gap + fundal, ca o grila tehnica */
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .serviciu {
    display: flex;
    flex-direction: column;
    background: var(--stone-2);
    transition: background var(--tr);
  }

  .serviciu:hover {
    background: #fff;
  }

  /* ---- Fotografia ---- */
  .serviciu__figura {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--stone-3);
    border-bottom: 1px solid var(--line);
  }

  .serviciu__imagine {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .serviciu:hover .serviciu__imagine {
    transform: scale(1.04);
  }

  .serviciu__numar {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.35rem 0.7rem;
    background: var(--stone-2);
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--terra-text);
  }

  /* ---- Textul ---- */
  .serviciu__corp {
    padding: 1.9rem 1.75rem 2rem;
    flex-grow: 1;
  }

  .serviciu__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 1.25rem;
    border: 1px solid var(--line-indigo);
    color: var(--indigo);
  }

  .serviciu__titlu {
    margin-bottom: 0.7rem;
    font-size: 1.14rem;
  }

  .serviciu__descriere {
    font-size: 0.87rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--ink-2);
  }

  /* ---- Legătura către portofoliu ---- */
  .spre-lucrari {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--stone-2);
    border: 1px solid var(--line);
    color: var(--ink);
    transition: var(--tr);
  }

  .spre-lucrari:hover {
    background: var(--indigo);
    border-color: var(--indigo);
    color: var(--stone-2);
  }

  .spre-lucrari__text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .spre-lucrari__titlu {
    font-family: var(--f-display);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .spre-lucrari:hover :global(.eticheta) {
    color: rgba(249, 248, 246, 0.8);
  }

  .spre-lucrari svg {
    flex-shrink: 0;
    transition: transform var(--tr);
  }

  .spre-lucrari:hover svg {
    transform: translateX(5px);
  }
</style>
