---
import { Picture } from 'astro:assets';
import { SERVICII_PRINCIPALE } from '~/data/servicii';
import IconServiciu from '~/components/IconServiciu.astro';
---

<section class="sectiune servicii" id="servicii">
  <div class="container">
    <div class="servicii__antet">
      <p class="eticheta">Ce executăm</p>
      <h2>Șase lucrări, de la structură<br />până la finisajul final</h2>
    </div>

    <ul class="servicii__lista">
      {
        SERVICII_PRINCIPALE.map((s, i) => (
          <li class="serviciu">
            <figure class="serviciu__figura">
              <Picture
                src={s.poza}
                alt={s.pozaAlt}
                formats={['avif', 'webp']}
                widths={[320, 520, 760]}
                sizes="(max-width: 640px) 92vw, (max-width: 1080px) 46vw, 31vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                class="serviciu__imagine"
              />
              <span class="serviciu__numar mono">{String(i + 1).padStart(2, '0')}</span>
            </figure>

            <div class="serviciu__corp">
              <span class="serviciu__icon">
                <IconServiciu nume={s.icon} size={22} />
              </span>
              <h3>{s.titlu}</h3>
              <p>{s.descriere}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .servicii {
    background: var(--stone);
  }

  .servicii__antet {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .servicii__antet h2 {
    margin-top: 1rem;
  }

  .servicii__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    /* liniile dintre carduri se fac din gap + fundal, ca o grila tehnica */
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .serviciu {
    display: flex;
    flex-direction: column;
    background: var(--stone-2);
    transition: background var(--tr);
  }

  .serviciu:hover {
    background: #fff;
  }

  .serviciu__figura {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--stone-3);
    border-bottom: 1px solid var(--line);
  }

  .serviciu__imagine {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .serviciu:hover .serviciu__imagine {
    transform: scale(1.035);
  }

  .serviciu__numar {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.35rem 0.7rem;
    background: var(--stone-2);
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--terra-text);
  }

  .serviciu__corp {
    padding: 1.75rem 1.6rem 1.9rem;
    flex-grow: 1;
  }

  .serviciu__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 1.1rem;
    border: 1px solid var(--line-indigo);
    color: var(--indigo);
  }

  .serviciu h3 {
    font-size: 1.12rem;
    margin-bottom: 0.6rem;
  }

  .serviciu p {
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-2);
  }
</style>
